* { box-sizing: border-box; }

html { text-size-adjust: 100%; }

html, button, input, select, option, optgroup, textarea { font-family: Lato=
, sans-serif; font-size: 1em; background-color: rgb(255, 255, 255); }

optgroup { background-color: rgb(255, 255, 254); }

body { color: rgb(0, 0, 0); font-size: 1em; line-height: 1.5em; margin: 0px=
; overflow-y: scroll; }

a:link { color: rgb(0, 0, 153); transition: none; }

a:visited { color: purple; }

a[data-lbwps-width] > img:hover { cursor: zoom-in; }

h1, h2, h3, h4, h5, h6 { color: rgb(0, 0, 0); font-weight: bold; line-heigh=
t: 1.2; text-wrap: balance; }

