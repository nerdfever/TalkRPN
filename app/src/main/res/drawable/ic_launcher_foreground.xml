<?xml version="1.0" encoding="utf-8"?>

<!--
    The glyph layer of the launcher icon: "RPN" in the display's own idiom -
    straight LED-style bars, butt-ended, meeting at open corners the way the
    segment font's centreline strokes do - in the display's neon orange.

    Adaptive icons are always authored on a 108x108 canvas, of which only the
    middle 66x66 is guaranteed visible - the launcher may mask or animate the
    rest away. The letters below stay inside that safe circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- R -->
    <path android:strokeColor="#FF5F1F" android:strokeWidth="4.5"
        android:pathData="M26,40 L26,68 M26,40 L40,40 M40,40 L40,54 M26,54 L40,54 M33,54 L40,68" />

    <!-- P -->
    <path android:strokeColor="#FF5F1F" android:strokeWidth="4.5"
        android:pathData="M47,40 L47,68 M47,40 L61,40 M61,40 L61,54 M47,54 L61,54" />

    <!-- N -->
    <path android:strokeColor="#FF5F1F" android:strokeWidth="4.5"
        android:pathData="M68,40 L68,68 M68,40 L82,68 M82,40 L82,68" />
</vector>
