<?xml version="1.0" encoding="utf-8"?>

<!--
    The launcher icon, as an "adaptive icon": two separate layers that the launcher
    composes, masks to the device's icon shape, and can animate independently.

    Only this density-independent version is provided, which is fine because the app's
    minSdk is 30 — every device that can install it understands adaptive icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
