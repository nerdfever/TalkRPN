<?xml version="1.0" encoding="utf-8"?>

<!--
    The round variant, requested by launchers that always use circular icons — which is
    every Wear OS launcher. Adaptive icons are masked to shape anyway, so this is
    deliberately identical to ic_launcher.xml; the manifest just has to point somewhere.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />

    <!-- Themed-icon layer; see ic_launcher.xml. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
