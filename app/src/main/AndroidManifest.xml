<?xml version="1.0" encoding="utf-8"?>

<!--
    The manifest is the app's declaration to the operating system: what hardware it
    needs, what it may do, what it is called, and which screens it offers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        A watch app, and only a watch app. Marking the feature required means the app
        is never offered to phones, tablets, TV, Auto or XR.

        (required="true" is already the default for uses-feature, but it is stated
        explicitly here because it is a deliberate decision rather than an oversight.)
    -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <!-- Recording audio is the entire point of this build. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Read-only: lets each logged result record whether a network was even reachable
        at the time. The platform recognizer never says whether it used a server, so
        "was one available" is the only handle we have on that question.

        Note this grants no ability to USE the network - see the INTERNET note below.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Development-only, and it does nothing unless explicitly granted over ADB:
            adb shell pm grant com.nerdfever.talkrpn android.permission.WRITE_SECURE_SETTINGS

        Used solely to toggle Settings.Global.adb_wifi_enabled, so wireless debugging
        can be switched back on from inside the app. Android turns it off whenever the
        Wi-Fi connection so much as flickers, and digging through developer options
        every time has cost us three test sessions.

        REMOVE THIS before the app is ever anything but a test rig.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        NOTE: android.permission.INTERNET is deliberately absent, and must stay absent.
        Without it this process cannot open a socket at all, which makes "no cloud
        calls" a property enforced by the operating system rather than a promise.

        The caveat worth remembering: the recognition service runs in its *own*
        process with its own permissions. Our lack of INTERNET stops us reaching the
        network; it does not stop the recognizer doing so. That is why the app insists
        on createOnDeviceSpeechRecognizer rather than trusting the default recognizer.
    -->

    <!--
        Since Android 11 an app cannot see other installed packages by default.
        Without this declaration, querying for installed recognition services returns
        an empty list even when several are present - which would make the probe
        report "none installed" on a device that has them.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!--
        android:allowBackup is deliberately absent: it was deprecated in Android 12,
        and backup is on by default. Declaring it added nothing but a lint warning.
    -->
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TalkRPN">

        <!-- "Standalone" means the app works on its own, with no companion phone app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!--
            android:exported="true" is required for anything the launcher can start
            on modern Android; without it the system refuses to install the app.
        -->
        <!--
            taskAffinity="" keeps this activity in its own task, which is what Wear OS
            expects - otherwise it can surface oddly in the recents carousel.

            No android:label here: it would only repeat the application label above.
        -->
        <activity
            android:name=".MainActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.TalkRPN"
            android:exported="true">

            <!-- This filter is what puts the app in the watch's app list. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The display-size test. Reached from a button on the main screen rather
            than from the launcher: it is a measuring instrument, not a second app,
            and a second icon in the watch's app list would only be in the way.

            exported="true" so that `adb shell am start` can open it directly, which
            is the whole development loop for a screen whose only purpose is to be
            looked at and adjusted. It displays fixed sample digits and reads nothing,
            so there is nothing here for another app to reach. Revisit if this screen
            ever survives into the shipped app.
        -->
        <activity
            android:name=".DisplayTestActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.TalkRPN"
            android:exported="true" />

        <!--
            Four rows of digits at two bar positions and two stroke widths, for
            judging both against each other on the real screen. Same reasoning as
            DisplayTestActivity for exported="true": it exists to be launched from
            adb during design, and shows nothing but fixed sample digits.
        -->
        <activity
            android:name=".FontCompareActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.TalkRPN"
            android:exported="true" />

        <!--
            One TalkRpnFont cell, as large as the screen allows, for checking the
            28-segment geometry before any glyph table exists. Steps through the
            segments one at a time so a mislabelled or misplaced one is caught
            before ninety-odd glyphs are drawn against it.

            Same reasoning as the two above for exported="true".
        -->
        <activity
            android:name=".FontTestActivity"
            android:taskAffinity=""
            android:theme="@style/Theme.TalkRPN"
            android:exported="true" />
    </application>
</manifest>

