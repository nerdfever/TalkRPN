@charset "utf-8";

.star_rating, .star_rating li a:hover, .star_rating .current_rating { backg=
round: url("images/star_rating.png") left -1000px repeat-x; vertical-align:=
 middle; }

.star_rating { position: relative; width: 80px; height: 16px; overflow: hid=
den; list-style: none; margin: 0px; padding: 0px; background-position: left=
 top; }

td .star_rating { margin: auto; }

.star_rating li { display: inline; }

.star_rating li a, .star_rating .current_rating { position: absolute; text-=
indent: -1000px; height: 16px; line-height: 16px; outline: none; overflow: =
hidden; border-width: medium; border-style: none; border-color: currentcolo=
r; border-image: none; top: 0px; left: 0px; }

.star_rating_notrated li a:hover { background-position: left bottom; }

.star_rating li a.one_star { width: 20%; z-index: 6; }

.star_rating li a.two_stars { width: 40%; z-index: 5; }

.star_rating li a.three_stars { width: 60%; z-index: 4; }

.star_rating li a.four_stars { width: 80%; z-index: 3; }

.star_rating li a.five_stars { width: 100%; z-index: 2; }

.star_rating .current_rating { z-index: 1; background-position: left center=
; }

.star_rating_success, .success_message { color: rgb(0, 178, 0); font-weight=
: bold; font-size: 10px; margin-bottom: 10px; }

.inline_rating { background: url("images/star_rating.png") left -1000px rep=
eat-x; float: left; vertical-align: middle; padding-right: 5px; }

ul.thread_tools, ul.thread_tools li { list-style: none; padding: 0px; margi=
n: 0px; }

ul.thread_tools li { padding-left: 24px; padding-bottom: 4px; margin-bottom=
: 3px; font-size: 11px; background-image: url("images/showthread_sprite.png=
"); background-repeat: no-repeat; }

ul.thread_tools li.printable { background-position: 0px 0px; }

ul.thread_tools li.sendthread { background-position: 0px -20px; }

ul.thread_tools li.subscription_add { background-position: 0px -40px; }

ul.thread_tools li.subscription_remove { background-position: 0px -60px; }

ul.thread_tools li.poll { background-position: 0px -80px; }

.showthread_spinner { width: 100%; margin: 0px auto; display: block; text-a=
lign: center; padding: 20px; }
