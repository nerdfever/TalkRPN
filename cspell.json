// Spell checking for this project.
//
// Here rather than in .vscode/settings.json because this is cSpell's own config
// file: the extension reads it directly, and so does the CLI, so the same list
// can be checked from a terminal:
//
//     npx cspell lint "app/src/main/java/**/*.kt" "*.md" "font_design/*.ps1"
{
    "version": "0.2",

    // British spelling throughout the comments - centreline, millimetre, colour,
    // normalise. Both locales are listed so American spellings stay valid too and
    // a mixed file does not start complaining in the other direction.
    "language": "en,en-GB",

    // Words no dictionary carries. Every entry below is a real name, a part
    // number, an API identifier or a term this project coined - not a spelling
    // this file is papering over.
    "words": [
        // Android, Compose and the toolchain
        "adbd",
        "androidx",
        "readln",
        "Argb",
        "drawscope",
        "gradlew",
        "gwear",
        "javap",
        "keyevent",
        "kotlinx",
        "LOCALAPPDATA",
        "logcat",
        "recents",
        "recompositions",
        "screencap",
        "sdcard",
        "SEGS",
        "sharedpref",

        // Speech recognition
        "endpointer",
        "googletts",
        "intellivoiceservice",
        "Kaldi",
        "relistening",
        "rmsd",
        "Vosk",

        // The display, the font and the hardware behind them
        "Beziers",
        "Bugseye",
        "CIEDE",
        "datasheet",
        "datasheets",
        "EDID",
        "FWHM",
        "HDLS",
        "Litronix",
        "Panamatik",
        "QDSP",
        "abilist",
        "AOSP",
        "armeabi",
        "dumpsys",
        "Exynos",
        "getprop",
        "proguard",
        "Proguard",
        "mdns",
        "unsheared",
        "vgap",
        "vpitch",

        // This project's own vocabulary
        "dotfp",
        "dotg",
        "LASTX",
        "segfp",
        "nerdfever",
        "protolayout",
        "talkrpn",
        "watchface",
        "wdbtile",
        "rects",
        "relayout",
        "rescuable",
        "tweakable",
        "Tweakables",
        "Unioned",

        // Typefaces named in the rendering scripts
        "Consolas",
        "fonttools",
        "Segoe",

        // PDF syntax written by the generator scripts - the keyword itself, and
        // the forms where a preceding \n in a PowerShell string runs into it:
        // \nendobj, \nstream and so on.
        "endstream",
        "nendobj",
        "nendstream",
        "nstartxref",
        "nstream",

        // The engine tester's tkinter pad
        "columnspan",
        "padx",
        "pady",
        "tkinter",

        // Windows / display plumbing
        "davel",
        "xdpi"
    ]
}
