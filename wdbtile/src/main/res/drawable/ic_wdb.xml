<?xml version="1.0" encoding="utf-8"?>
<!-- The app/tile icon: a lit LED - a red ring around a red dot - in the same
     red as the calculator display. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- The ring. -->
    <path
        android:pathData="M 24,6 A 18,18 0 1,1 23.99,6 Z M 24,12 A 12,12 0 1,0 24.01,12 Z"
        android:fillColor="#FF0000"
        android:fillType="evenOdd" />

    <!-- The dot. -->
    <path
        android:pathData="M 24,18 A 6,6 0 1,1 23.99,18 Z"
        android:fillColor="#FF0000" />

</vector>
